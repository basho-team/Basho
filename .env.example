# Copie para .env e preencha. Nunca versione o .env.
# Docker compose (Postgres local)
POSTGRES_DB=basho
POSTGRES_USER=basho
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Migrações (Alembic): role dono do schema, ex. o POSTGRES_USER acima.
# Só para `alembic upgrade`; a API e o worker nunca usam esta URL.
MIGRATION_DATABASE_URL=

# Backend (todas obrigatórias; a API não inicia sem elas)
# Login da aplicação, membro de basho_api (worker: membro de basho_worker), sem
# BYPASSRLS e sem UPDATE/DELETE no ledger. Ver backend/README.md "Roles do banco e RLS".
DATABASE_URL=
ANTHROPIC_API_KEY=
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=
CHECKER_MODEL=
GITHUB_TOKEN=
# UUID do tenant fixo do MVP (ex.: gerado com `uuidgen`)
TENANT_ID=
# Opcional: segredo compartilhado com o BFF do Next que repassa a identidade do revisor
# (headers X-Basho-*). Vazio = POST /api/v1/reports/{id}/review fica fechado (503).
# Placeholder até existir autenticação real.
REVIEWER_IDENTITY_SECRET=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
