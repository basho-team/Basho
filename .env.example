# Copie para .env e preencha. Nunca versione o .env.
# Docker compose (Postgres local)
POSTGRES_DB=basho
POSTGRES_USER=basho
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Migrações (Alembic): role dono do schema, ex. o POSTGRES_USER acima.
# Só para `alembic upgrade`; a API e o worker nunca usam esta URL.
MIGRATION_DATABASE_URL=

# Backend (todas obrigatórias; a API não inicia sem elas)
# Login da aplicação, membro de basho_api (worker: membro de basho_worker), sem
# BYPASSRLS e sem UPDATE/DELETE no ledger. Ver backend/README.md "Roles do banco e RLS".
DATABASE_URL=
ANTHROPIC_API_KEY=
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=
# Opcional: segunda conta do Featherless; usada se a primária responder 401/402/403 (sem crédito)
FEATHERLESS_FALLBACK_API_KEY=
CHECKER_MODEL=
GITHUB_TOKEN=
# UUID do tenant fixo do MVP (ex.: gerado com `uuidgen`)
TENANT_ID=
# Opcional (mín. 32 caracteres): segredo compartilhado com o BFF do Next, só server-side,
# que repassa a identidade do revisor
# (headers X-Basho-*). Vazio = POST /api/v1/reports/{id}/review fica fechado (503).
# Placeholder até existir autenticação real.
REVIEWER_IDENTITY_SECRET=

# Maker e Checker (ADR-0011): Featherless por padrão na demo, modelos diferentes
# MAKER_PROVIDER=featherless
# MAKER_MODEL=deepseek-ai/DeepSeek-V3.1
# CHECKER_MODEL=zai-org/GLM-4.6
# CHECKER_FALLBACK_MODEL=moonshotai/Kimi-K2-Instruct-0905
# Com MAKER_PROVIDER=anthropic: MAKER_MODEL=claude-opus-5-5 e ANTHROPIC_API_KEY
# MAKER_EFFORT=high
# Worker: fixtures sintéticas do GitHub para as tools simuladas (até o #7)
# GITHUB_FIXTURES_DIR=backend/tests/fixtures/github
# Worker: GitHub real por projeto (JSON {project_id: "owner/name"}); exige GITHUB_TOKEN
# GITHUB_PROJECT_REPOS={"00000000-0000-0000-0000-000000000000": "owner/repo"}

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
# mock = dados sintéticos de demonstração (padrão); api = backend real
NEXT_PUBLIC_DATA_SOURCE=mock
# Projeto da demonstração no modo api (UUID; não é segredo). Usado em pendências e dossiê.
NEXT_PUBLIC_BASHO_PROJECT_ID=

# BFF do Next (só servidor: NUNCA prefixar com NEXT_PUBLIC_).
# URL do backend vista pelo servidor do Next.
BASHO_API_URL=http://localhost:8000
# O BFF envia ao backend o REVIEWER_IDENTITY_SECRET acima junto com a identidade do revisor:
# precisa ser O MESMO valor no backend e no Next (mín. 32 caracteres). Nunca coloque em
# variável exposta a preview público.
# Revisores que a troca de papel da demo pode assumir: "<uuid>:researcher,<uuid>:manager".
# O BFF manda essa identidade em TODAS as chamadas (leituras inclusive); a rota da tela
# (/pesquisador, /gerente) define o papel e vale a primeira pessoa da lista com esse papel.
# Vazio = revisão indisponível (503).
# ATENÇÃO: o BFF NÃO autentica (placeholder até #47). Quem alcança o Next escolhe um revisor
# da lista. Não publique o deploy sem uma camada de acesso (basic auth, Vercel protection).
BASHO_DEMO_REVIEWERS=
# Worker: Google Drive (ADR-0010, só leitura). OAuth com refresh token, escopo drive.readonly
# GOOGLE_DRIVE_CLIENT_ID=
# GOOGLE_DRIVE_CLIENT_SECRET=
# GOOGLE_DRIVE_REFRESH_TOKEN=
# GOOGLE_DRIVE_PROJECT_FOLDERS={"00000000-0000-0000-0000-000000000000": ["<folder_id>"]}
# Worker: Notion (ADR-0010, só leitura). Token de integração interna; compartilhe as páginas com ela
# NOTION_TOKEN=
# NOTION_PROJECT_SOURCES={"00000000-0000-0000-0000-000000000000": ["database:<id>", "page:<id>"]}
