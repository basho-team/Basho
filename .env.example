# Copie para .env e preencha. Nunca versione o .env.
# Docker compose (Postgres local)
POSTGRES_DB=basho
POSTGRES_USER=basho
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Backend (todas obrigatórias; a API não inicia sem elas)
DATABASE_URL=
ANTHROPIC_API_KEY=
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=
CHECKER_MODEL=
GITHUB_TOKEN=
# UUID do tenant fixo do MVP (ex.: gerado com `uuidgen`)
TENANT_ID=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
