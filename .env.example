# Copie para .env e preencha. Nunca versione o .env.
# Docker compose (Postgres local)
POSTGRES_DB=basho
POSTGRES_USER=basho
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Migrações (Alembic): role dono do schema, ex. o POSTGRES_USER acima.
# Só para `alembic upgrade`; a API e o worker nunca usam esta URL.
MIGRATION_DATABASE_URL=

# Backend (todas obrigatórias; a API não inicia sem elas)
# Login da aplicação, membro de basho_api (worker: membro de basho_worker), sem
# BYPASSRLS e sem UPDATE/DELETE no ledger. Ver backend/README.md "Roles do banco e RLS".
DATABASE_URL=
ANTHROPIC_API_KEY=
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=
CHECKER_MODEL=
GITHUB_TOKEN=
# UUID do tenant fixo do MVP (ex.: gerado com `uuidgen`)
TENANT_ID=
# Opcional (mín. 32 caracteres): segredo compartilhado com o BFF do Next, só server-side,
# que repassa a identidade do revisor
# (headers X-Basho-*). Vazio = POST /api/v1/reports/{id}/review fica fechado (503).
# Placeholder até existir autenticação real.
REVIEWER_IDENTITY_SECRET=

# Maker (opcionais; descomente só para trocar o padrão)
# MAKER_MODEL=claude-opus-5-5
# MAKER_EFFORT=high

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
# mock = dados sintéticos de demonstração (padrão); api = backend real
NEXT_PUBLIC_DATA_SOURCE=mock

# BFF do Next (só servidor: NUNCA prefixar com NEXT_PUBLIC_).
# URL do backend vista pelo servidor do Next.
BASHO_API_URL=http://localhost:8000
# O BFF envia ao backend o REVIEWER_IDENTITY_SECRET acima junto com a identidade do revisor:
# precisa ser O MESMO valor no backend e no Next (mín. 32 caracteres). Nunca coloque em
# variável exposta a preview público.
# Revisores que a troca de papel da demo pode assumir: "<uuid>:researcher,<uuid>:manager".
# Vazio = revisão indisponível (503).
# ATENÇÃO: o BFF NÃO autentica (placeholder até #47). Quem alcança o Next escolhe um revisor
# da lista. Não publique o deploy sem uma camada de acesso (basic auth, Vercel protection).
BASHO_DEMO_REVIEWERS=
